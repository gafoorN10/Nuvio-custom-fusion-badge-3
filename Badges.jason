    {
      "borderColor": "#ffffff",
      "groupId": "gr",
      "id": "r-4k",
      "imageURL": "data:image/png;base64,",
      "isEnabled": true,
      "name": "4K",
      "pattern": "(?i)^(?=.*(?:2160[pi]?|4k|uhd))(?!.*(?:1080[pi]?|720[pi]?))",
      "tagColor": "#00000000",
      "tagStyle": "bordered",
      "textColor": "#FFFFFF",
      "type": "filter"
    },
    {
      "borderColor": "#ffffff",
